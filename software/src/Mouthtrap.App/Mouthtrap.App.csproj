<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- The release is published self-contained for this runtime; restoring it keeps that publish locked. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- English is neutral; keep only the Japanese resources of the runtime and the packages. -->
    <SatelliteResourceLanguages>ja</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Mouthtrap.Core/Mouthtrap.Core.csproj" />
    <ProjectReference Include="../Mouthtrap.Inputs.Camera/Mouthtrap.Inputs.Camera.csproj" />
    <ProjectReference Include="../Mouthtrap.Sessions/Mouthtrap.Sessions.csproj" />
    <ProjectReference Include="../Mouthtrap.Inputs.Windows/Mouthtrap.Inputs.Windows.csproj" />
    <ProjectReference Include="../Mouthtrap.Inputs.Network/Mouthtrap.Inputs.Network.csproj" />
    <ProjectReference Include="../Mouthtrap.Outputs.VRChat/Mouthtrap.Outputs.VRChat.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Mouthtrap.App.Tests" />
  </ItemGroup>
</Project>
