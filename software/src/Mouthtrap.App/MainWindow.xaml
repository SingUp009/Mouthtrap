<Window x:Class="Mouthtrap.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Mouthtrap.App"
        Title="Mouthtrap" Width="1320" Height="880" MinWidth="1040" MinHeight="680"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Yu Gothic UI, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#F2F4F8" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#E1E6EE" />
        <SolidColorBrush x:Key="FieldLineBrush" Color="#C9D1DD" />
        <SolidColorBrush x:Key="TextBrush" Color="#172338" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5A6879" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2F6FEB" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#245CCB" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#1C4BA8" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#E8F0FE" />
        <SolidColorBrush x:Key="HoverBrush" Color="#F1F4F9" />
        <SolidColorBrush x:Key="PressedBrush" Color="#E3E8F0" />
        <SolidColorBrush x:Key="RunningBrush" Color="#1FA463" />
        <SolidColorBrush x:Key="StoppingBrush" Color="#E3A008" />
        <SolidColorBrush x:Key="IdleBrush" Color="#9AA6B6" />
        <SolidColorBrush x:Key="StageBrush" Color="#111821" />
        <SolidColorBrush x:Key="StageTextBrush" Color="#E9EEF5" />
        <SolidColorBrush x:Key="StageMutedBrush" Color="#A9B6C6" />

        <!-- Keyboard focus stays visible on every control. -->
        <Style x:Key="FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3" RadiusX="9" RadiusY="9" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource PressedBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value=".45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{StaticResource AccentBrush}" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentHoverBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentPressedBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value=".4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource MutedBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Field" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Field" Property="Opacity" Value=".5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The Wi-Fi password field, drawn like the text fields. -->
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource MutedBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Field" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Field" Property="Opacity" Value=".5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Drop-downs drawn like the text fields. Only the non-editable form is used, so there is no PART_EditableTextBox.
             The built-in ComboBox keeps arrow keys, Alt+Down, typing to select and label access keys. -->
        <Style x:Key="ComboToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="ClickMode" Value="Press" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6,32,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MaxDropDownHeight" Value="320" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" />
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              HorizontalAlignment="Left" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <Path x:Name="Chevron" Data="M 0,0 L 5,5 L 10,0" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,1,12,0" IsHitTestVisible="False" />
                            <ToggleButton Style="{StaticResource ComboToggle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Popup x:Name="PART_Popup" Placement="Bottom" HorizontalOffset="-6" VerticalOffset="4" AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Fade" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <!-- The margin leaves room for the shadow inside the transparent popup. -->
                                <Border x:Name="DropDown" Margin="6,0,6,10" MinWidth="{Binding ActualWidth, ElementName=Field}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="{StaticResource CardBrush}"
                                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity=".16" Color="#172338" />
                                    </Border.Effect>
                                    <ScrollViewer x:Name="DropDownScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="True" Focusable="False">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource MutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Field" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Chevron" Property="Data" Value="M 0,5 L 5,0 L 10,5" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDown" Property="MinHeight" Value="36" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Field" Property="Background" Value="{StaticResource WindowBrush}" />
                                <Setter Property="Opacity" Value=".55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentPressedBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <!-- The highlighted row follows both the mouse and the arrow keys. -->
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsHighlighted" Value="True" />
                                    <Condition Property="IsSelected" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Row" Property="Background" Value="#DCE7FD" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Padding" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5" VerticalAlignment="Center"
                                    BorderBrush="{StaticResource FieldLineBrush}" Background="{StaticResource CardBrush}">
                                <Path x:Name="Mark" Data="M 3.5,8.5 L 7,12 L 13.5,4.5" Stroke="White" StrokeThickness="2" Visibility="Collapsed"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" RecognizesAccessKey="True" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A switch for the toggles that turn a whole feature on. Still a CheckBox for keyboard and UI Automation. -->
        <Style x:Key="Switch" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <DockPanel Background="Transparent" LastChildFill="False">
                            <Border x:Name="Track" DockPanel.Dock="Right" Width="40" Height="22" CornerRadius="11" Background="{StaticResource IdleBrush}" VerticalAlignment="Center">
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3,0" />
                            </Border>
                            <ContentPresenter DockPanel.Dock="Left" RecognizesAccessKey="True" VerticalAlignment="Center" />
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="#4ADE9B" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="5" Background="#2A3544" />
                            <Border x:Name="PART_Indicator" CornerRadius="5" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A thin vertical scroll bar; horizontal ones keep the system look. -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Grip" CornerRadius="4" Background="#C3CBD6" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#98A4B4" /></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#7D8A9C" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="8" />
                    <Setter Property="MinWidth" Value="8" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" /></Track.Thumb>
                                    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" /></Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" /></Track.IncreaseRepeatButton>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource WindowBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="PathText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: what is running and the session buttons. -->
        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                        <TextBlock Text="M" Foreground="White" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Mouthtrap" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{app:Text HeaderSubtitle}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Pill}" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="SessionDot" Width="8" Height="8" Fill="{StaticResource IdleBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="SessionStateText" Text="{app:Text StateIdle}" Margin="6,0,0,0" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Pill}" Margin="0,0,16,0">
                        <TextBlock x:Name="CaptureFpsText" Text="{app:Text InputFpsIdle}" FontWeight="SemiBold" />
                    </Border>
                    <Button x:Name="RefreshButton" Content="{app:Text RefreshButton}" Click="Refresh_Click" />
                    <Button x:Name="StartButton" Content="{app:Text StartButton}" Click="Start_Click" IsEnabled="False" Style="{StaticResource PrimaryButton}" />
                    <Button x:Name="StopButton" Content="{app:Text StopButton}" Click="Stop_Click" IsEnabled="False" Margin="0" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Text="{app:Text StatusPreparing}" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Right"
                           TextTrimming="CharacterEllipsis" Margin="24,0,12,0" AutomationProperties.LiveSetting="Polite"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20,16,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Settings column. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,10,0">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{app:Text InputTitle}" Style="{StaticResource CardTitle}" />
                            <Label Content="{app:Text InputKindLabel}" Target="{Binding ElementName=InputKind}" />
                            <ComboBox x:Name="InputKind" SelectedIndex="0" SelectionChanged="InputKind_SelectionChanged" AutomationProperties.Name="{app:Text InputKindName}">
                                <ComboBoxItem Content="{app:Text InputCamera}" /><ComboBoxItem Content="{app:Text InputImage}" /><ComboBoxItem Content="{app:Text InputVideo}" /><ComboBoxItem Content="Wi-Fi (MJPEG)" />
                            </ComboBox>
                            <StackPanel x:Name="CameraOptions" Margin="0,10,0,0">
                                <Label Content="{app:Text CameraLabel}" Target="{Binding ElementName=Cameras}" />
                                <ComboBox x:Name="Cameras" AutomationProperties.Name="{app:Text CameraName}" SelectionChanged="Camera_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock><Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" — " /><Run Text="{Binding DeviceType, Mode=OneWay}" /></TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Label Content="{app:Text ModeLabel}" Target="{Binding ElementName=Modes}" Margin="0,8,0,0" />
                                <ComboBox x:Name="Modes" AutomationProperties.Name="{app:Text ModeName}" SelectionChanged="Mode_SelectionChanged" />
                            </StackPanel>
                            <DockPanel Margin="0,10,0,0">
                                <Button x:Name="FileButton" Content="{app:Text FileButton}" ToolTip="{app:Text FileButtonTip}" Click="File_Click" IsEnabled="False" Visibility="Collapsed" DockPanel.Dock="Left" />
                                <TextBlock x:Name="FilePathText" Text="{app:Text NoFile}" Style="{StaticResource PathText}" Visibility="Collapsed" />
                            </DockPanel>
                            <StackPanel x:Name="MjpegOptions" Visibility="Collapsed">
                                <Label Content="{app:Text UrlLabel}" Target="{Binding ElementName=MjpegUrl}" />
                                <TextBox x:Name="MjpegUrl" AutomationProperties.Name="{app:Text UrlName}"
                                         TextChanged="MjpegUrl_TextChanged" LostKeyboardFocus="Setting_LostFocus" />
                                <DockPanel Margin="0,8,0,0">
                                    <Button x:Name="TokenFileButton" Content="{app:Text TokenButton}" ToolTip="{app:Text TokenButtonTip}" Click="TokenFile_Click" DockPanel.Dock="Left" />
                                    <TextBlock x:Name="TokenFileText" Text="{app:Text NoToken}" Style="{StaticResource PathText}" />
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{app:Text CropTitle}" Style="{StaticResource CardTitle}" />
                            <CheckBox x:Name="CropEnabled" Content="{app:Text CropEnabled}" Style="{StaticResource Switch}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /><ColumnDefinition Width="8" />
                                    <ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Label Content="{app:Text CropLeftLabel}" Target="{Binding ElementName=CropX}" />
                                    <TextBox x:Name="CropX" Text="0" AutomationProperties.Name="{app:Text CropLeftName}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Content="{app:Text CropTopLabel}" Target="{Binding ElementName=CropY}" />
                                    <TextBox x:Name="CropY" Text="50" AutomationProperties.Name="{app:Text CropTopName}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <Label Content="{app:Text CropWidthLabel}" Target="{Binding ElementName=CropWidth}" />
                                    <TextBox x:Name="CropWidth" Text="100" AutomationProperties.Name="{app:Text CropWidthName}" />
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <Label Content="{app:Text CropHeightLabel}" Target="{Binding ElementName=CropHeight}" />
                                    <TextBox x:Name="CropHeight" Text="50" AutomationProperties.Name="{app:Text CropHeightName}" />
                                </StackPanel>
                            </Grid>
                            <DockPanel Margin="0,10,0,0">
                                <Button Content="{app:Text ApplyButton}" Click="ApplyPreprocessing_Click" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Margin="0" />
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="{app:Text RotationLabel}" Target="{Binding ElementName=Rotation}" VerticalAlignment="Center" Padding="0,0,8,0" />
                                    <ComboBox x:Name="Rotation" Width="84" SelectedIndex="0" AutomationProperties.Name="{app:Text RotationName}">
                                        <ComboBoxItem Content="0°" /><ComboBoxItem Content="90°" /><ComboBoxItem Content="180°" /><ComboBoxItem Content="270°" />
                                    </ComboBox>
                                    <CheckBox x:Name="Mirror" Content="{app:Text Mirror}" Margin="14,0,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock x:Name="PreprocessStatusText" Text="{app:Text CropHintFull}" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                            <TextBlock Text="{app:Text CropHintDrag}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{app:Text TrackingTitle}" Style="{StaticResource CardTitle}" />
                            <CheckBox x:Name="EnableTracking" Content="{app:Text EnableTracking}" Style="{StaticResource Switch}"
                                      Checked="EnableTracking_Changed" Unchecked="EnableTracking_Changed" />
                            <DockPanel Margin="0,10,0,0">
                                <Button x:Name="ModelFileButton" Content="{app:Text ModelButton}" Click="ModelFile_Click" DockPanel.Dock="Left" />
                                <TextBlock x:Name="ModelPathText" Text="{app:Text NoModel}" Style="{StaticResource PathText}" />
                            </DockPanel>
                            <Rectangle Height="1" Fill="{StaticResource LineBrush}" Margin="0,12" />
                            <CheckBox x:Name="AdaptiveCalibration" Content="{app:Text AdaptiveCalibration}" IsChecked="True"
                                      Checked="Setting_Changed" Unchecked="Setting_Changed" />
                            <DockPanel Margin="26,6,0,0">
                                <Button x:Name="ResetCalibrationButton" Content="{app:Text ResetCalibration}" Click="ResetCalibration_Click" IsEnabled="False" DockPanel.Dock="Left" />
                                <TextBlock Text="{app:Text CalibrationHint}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                            </DockPanel>
                            <CheckBox x:Name="Smoothing" Content="{app:Text Smoothing}" IsChecked="True" Margin="0,10,0,0"
                                      Checked="Setting_Changed" Unchecked="Setting_Changed" />
                            <CheckBox x:Name="Tongue" Content="{app:Text Tongue}" Margin="0,8,0,0"
                                      Checked="Setting_Changed" Unchecked="Setting_Changed" />
                            <DockPanel Margin="0,10,0,0">
                                <Label Content="{app:Text DeadzoneLabel}" Target="{Binding ElementName=Deadzone}" VerticalAlignment="Center" Padding="0,0,10,0" />
                                <TextBox x:Name="Deadzone" Text="0.15" Width="64" HorizontalAlignment="Left" AutomationProperties.Name="{app:Text DeadzoneName}"
                                         LostKeyboardFocus="Setting_LostFocus" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="VRChat" Style="{StaticResource CardTitle}" />
                            <CheckBox x:Name="OscEnabled" Content="{app:Text OscEnabled}" Style="{StaticResource Switch}"
                                      ToolTip="{app:Text OscTip}"
                                      Checked="Setting_Changed" Unchecked="Setting_Changed" />
                            <Label Content="{app:Text OscEndpointLabel}" Target="{Binding ElementName=OscEndpoint}" Margin="0,10,0,0" />
                            <TextBox x:Name="OscEndpoint" Text="127.0.0.1:9000" AutomationProperties.Name="{app:Text OscEndpointName}"
                                     LostKeyboardFocus="Setting_LostFocus" />
                            <TextBlock x:Name="OscStatusText" Text="{app:Text OscOff}" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{app:Text FirmwareTitle}" Style="{StaticResource CardTitle}" />
                            <Label Content="{app:Text FirmwareKindLabel}" Target="{Binding ElementName=FirmwareKind}" />
                            <ComboBox x:Name="FirmwareKind" SelectedIndex="0" AutomationProperties.Name="{app:Text FirmwareKindName}"
                                      SelectionChanged="FirmwareKind_SelectionChanged">
                                <ComboBoxItem Content="{app:Text FirmwareWifi}" /><ComboBoxItem Content="{app:Text FirmwareUvc}" /><ComboBoxItem Content="{app:Text FirmwareUvcMultimode}" />
                            </ComboBox>
                            <Label Content="{app:Text FirmwarePortLabel}" Target="{Binding ElementName=FirmwarePort}" Margin="0,8,0,0" />
                            <DockPanel>
                                <Button x:Name="FirmwarePortsButton" Content="{app:Text FirmwarePortsButton}" Click="FirmwarePorts_Click" DockPanel.Dock="Right" Margin="8,0,0,0" />
                                <ComboBox x:Name="FirmwarePort" AutomationProperties.Name="{app:Text FirmwarePortName}" SelectionChanged="FirmwarePort_SelectionChanged" />
                            </DockPanel>
                            <StackPanel x:Name="FirmwareWifiOptions">
                                <Label Content="{app:Text FirmwareSsidLabel}" Target="{Binding ElementName=FirmwareSsid}" Margin="0,8,0,0" />
                                <TextBox x:Name="FirmwareSsid" AutomationProperties.Name="{app:Text FirmwareSsidName}" TextChanged="FirmwareField_Changed" />
                                <Label Content="{app:Text FirmwarePasswordLabel}" Target="{Binding ElementName=FirmwarePassword}" Margin="0,8,0,0" />
                                <PasswordBox x:Name="FirmwarePassword" AutomationProperties.Name="{app:Text FirmwarePasswordName}" PasswordChanged="FirmwareField_Changed" />
                            </StackPanel>
                            <TextBlock x:Name="FirmwareHint" Text="{app:Text FirmwareHintWifi}" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                            <Button x:Name="FirmwareWriteButton" Content="{app:Text FirmwareWriteButton}" Click="FirmwareWrite_Click" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0" IsEnabled="False" />
                            <ProgressBar x:Name="FirmwareProgress" Minimum="0" Maximum="1" Height="8" Margin="0,10,0,0" Visibility="Collapsed"
                                         AutomationProperties.Name="{app:Text FirmwareProgressName}" />
                            <TextBlock x:Name="FirmwareStatusText" Text="{app:Text FirmwareIdle}" Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{app:Text LanguageTitle}" Style="{StaticResource CardTitle}" />
                            <Label Content="{app:Text LanguageLabel}" Target="{Binding ElementName=LanguageChoice}" />
                            <ComboBox x:Name="LanguageChoice" SelectedIndex="0" AutomationProperties.Name="{app:Text LanguageName}"
                                      SelectionChanged="Language_SelectionChanged">
                                <ComboBoxItem Content="{app:Text LanguageSystem}" /><ComboBoxItem Content="English" /><ComboBoxItem Content="日本語" />
                            </ComboBox>
                            <TextBlock x:Name="LanguageHint" Text="{app:Text LanguageRestart}" Style="{StaticResource Hint}" Margin="0,8,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="SettingsStatusText" Text="{app:Text SettingsLoading}" Style="{StaticResource Hint}" Margin="4,0,4,12" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <!-- Preview column. -->
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="2*" MinWidth="250" />
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource StageBrush}" CornerRadius="12" ClipToBounds="True">
                    <Grid>
                        <TextBlock x:Name="PreviewHint" Text="{app:Text PreviewHint}"
                                   Foreground="{StaticResource StageMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Viewbox Stretch="Uniform" Margin="12">
                            <Grid x:Name="PreviewSurface" Width="1280" Height="720" Background="Transparent" Cursor="Cross"
                                  MouseLeftButtonDown="Preview_MouseDown" MouseMove="Preview_MouseMove" MouseLeftButtonUp="Preview_MouseUp"
                                  LostMouseCapture="Preview_LostMouseCapture" ToolTip="{app:Text PreviewTip}">
                                <Image x:Name="Preview" Stretch="Fill" AutomationProperties.Name="{app:Text PreviewName}" />
                                <Canvas IsHitTestVisible="False"><Rectangle x:Name="CropOutline" Stroke="#59F7B2" StrokeThickness="4" Visibility="Collapsed" /></Canvas>
                            </Grid>
                        </Viewbox>
                        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12" Padding="10,4" CornerRadius="8" Background="#99000000">
                            <TextBlock Text="{app:Text PreviewName}" Foreground="{StaticResource StageTextBrush}" FontSize="12" />
                        </Border>
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="12" Padding="10,4" CornerRadius="8" Background="#99000000">
                            <TextBlock x:Name="FrameStatsText" Text="{app:Text FrameStatsIdle}" Foreground="{StaticResource StageMutedBrush}"
                                       FontSize="11" TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource StageBrush}" CornerRadius="12" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock x:Name="ProcessedTitleText" Text="{app:Text ProcessedIdle}" Foreground="{StaticResource StageMutedBrush}" FontSize="12" Margin="0,0,0,10" />
                        <DockPanel Grid.Row="1">
                            <DockPanel x:Name="AdditionalExpressionPanel" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="0,10,0,0" MaxHeight="180">
                                <TextBlock DockPanel.Dock="Top" Text="{app:Text AdditionalTitle}" Foreground="{StaticResource StageTextBrush}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="True" AutomationProperties.Name="{app:Text AdditionalName}">
                                    <TextBlock x:Name="AdditionalExpressionText" Foreground="{StaticResource StageMutedBrush}" FontFamily="Consolas, Yu Gothic UI" FontSize="12" TextWrapping="Wrap" />
                                </ScrollViewer>
                            </DockPanel>
                            <Image x:Name="ProcessedPreview" Stretch="Uniform" AutomationProperties.Name="{app:Text ProcessedName}" />
                        </DockPanel>
                        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                            <TextBlock x:Name="JawOpenText" Text="{app:Text JawOpenNone}" Foreground="{StaticResource StageTextBrush}" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,8" />
                            <ProgressBar x:Name="JawOpenBar" Minimum="0" Maximum="1" Height="10" Visibility="Collapsed" AutomationProperties.Name="{app:Text JawOpenName}" />
                            <TextBlock x:Name="TrackingStatsText" Text="{app:Text TrackingOff}" Foreground="{StaticResource StageMutedBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="PreprocessStatsText" Text="{app:Text PreprocessNone}" Foreground="{StaticResource StageMutedBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
